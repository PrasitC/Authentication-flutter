<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Allow cleartext (http) just for your local API host -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">192.168.29.128</domain>
  </domain-config>
  <!-- (Optional) To allow ALL cleartext, uncomment: -->
  <!--
  <base-config cleartextTrafficPermitted="true"/>
  -->
</network-security-config>
